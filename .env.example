# 참고용 문서: 필요한 환경변수 목록 (자동 로드되지 않음 — .env 파일이 아니라 OS 환경변수로 설정해야 함)
#   Windows:      setx TMAP_APP_KEY 실제키값   (새 터미널부터 적용)
#   macOS/Linux:  export TMAP_APP_KEY=실제키값
#
# Open Topo Data, Nominatim(OSM)은 키 불필요.

TMAP_APP_KEY=        # https://console.tmapmobility.com/
KMA_API_KEY=          # https://apihub.kma.go.kr/ (발급 후 사용할 API별로 별도 활용신청 승인 필요)
AIRKOREA_API_KEY=     # https://www.data.go.kr/ 에어코리아 대기질 정보 서비스
